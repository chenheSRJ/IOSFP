<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<key>Bundles</key>
		<array>
			<!-- v0.2 变更：从“全局注入”改为白名单注入。
			     全局注入会让 OneStepPaster 进入 SpringBoard / 各类系统守护
			     进程，是白苹果（启动循环）的高危来源。现在只注入下方常用的
			     文本输入类 App，自动粘贴与剪贴板历史上报只在这些 App 生效。 -->
			<string>com.apple.mobilenotes</string>
			<string>com.apple.reminders</string>
			<string>com.apple.MobileSMS</string>
			<string>com.apple.mobilemail</string>
			<string>com.apple.mobilesafari</string>
			<string>com.tencent.xin</string>
			<string>com.tencent.mqq</string>
			<string>com.laiwang.DingTalk</string>
			<string>ph.telegra.Telegraph</string>
			<string>net.whatsapp.WhatsApp</string>
			<string>com.apple.Preferences</string>
		</array>
	</dict>
</dict>
</plist>
